# .env.example — 커밋용 템플릿. 실제 값은 .env.{local,dev,staging,prod}(gitignored)에.
# 복사: cp .env.example .env.local  (그리고 ENV/DATABASE_URL 등 조정)

# --- core ---
ENV=local                                    # local | dev | staging | prod
# local:  sqlite:///./local.db
# dev+:   postgresql://redactflow:<pw>@postgres:5432/redactflow
DATABASE_URL=sqlite:///./local.db
REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=                            # dev+ 만. prod=Secret Manager 주입

# --- 벡터 백엔드 / vector ---
VECTOR_BACKEND=sqlite                         # sqlite | pgvector | qdrant | weaviate
# QDRANT_URL=http://qdrant:6333               # VECTOR_BACKEND=qdrant 시 (--profile vector)

# --- 객체 저장 / object store (dev+ minio) ---
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# S3_ENDPOINT=http://minio:9000

# --- 서비스 API base ---
DEID_API_BASE=http://localhost:8001
RAG_API_BASE=http://localhost:8002

# --- 정책엔진 / vault (PRD 미결정 → 스텁) ---
POLICY_ENGINE=builtin                         # builtin | opa | cedar
VAULT_URL=memory://                           # 구현 시 KMS/HSM 백엔드
# KMS_KEY_ID=

# --- 관측성 / observability ---
LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
